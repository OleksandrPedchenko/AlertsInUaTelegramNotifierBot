{
  "id": null,
  "uid": "alerts-bot-cpu-performance",
  "title": "Alerts Bot — CPU & RAM Performance",
  "tags": [
    "alerts-bot",
    "performance",
    "memory"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "quick_ranges": [
      {
        "from": "now-24h",
        "to": "now",
        "display": "Last 24 hours"
      },
      {
        "from": "now-7d",
        "to": "now",
        "display": "Last 7 days"
      },
      {
        "from": "now-30d",
        "to": "now",
        "display": "Last 30 days"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "custom",
        "query": "alerts,light",
        "current": {
          "text": "All",
          "value": "alerts|light"
        },
        "includeAll": true,
        "allValue": "alerts|light",
        "options": []
      },
      {
        "name": "cpu_threshold_ms",
        "type": "textbox",
        "query": "10",
        "current": {
          "text": "10",
          "value": "10"
        }
      },
      {
        "name": "run_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Executions",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=~\"alerts-tg-bot|poe-notifier\",level=\"info\",job=~\"${job:regex}\"} | json | event=\"job_performance\" | __error__=\"\"[$__range]))",
          "queryType": "instant",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No measurements yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success / failure / skipped",
