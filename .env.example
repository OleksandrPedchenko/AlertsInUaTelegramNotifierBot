ALERTS_API_TOKEN=replace_with_real_token
ALERTS_API_HOST=https://api.alerts.in.ua
ALERTS_API_PATH_TEMPLATE=/v1/iot/active_air_raid_alerts/{regionId}.json
ALERTS_USE_ACTIVE_ENDPOINT=false
ALERTS_ACTIVE_API_PATH=/v1/alerts/active.json
ALERTS_ACTIVE_MATCH_CRITERIA={"alert_type":"air_raid","location_oblast":"Полтавська область","finished_at":null}
ALERTS_ACTIVE_STUB_FILE=response.json
REGION_ID=19
TG_BOT_TOKEN=replace_with_real_bot_token
TG_CHAT_ID=replace_with_chat_id
ALERTS_USE_STUB=true
ALERTS_STUB_RESPONSE=A
ALWAYS_SEND_TG_MESSAGE=true
TREAT_P_AS_A=false
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_DELAY_MS=500
TG_HTTP_TIMEOUT_MS=10000
TG_HTTP_MAX_RETRIES=2
TG_HTTP_RETRY_BASE_DELAY_MS=500
LOCK_FILE_PATH=.alerts-job.lock
STATE_FILE_PATH=.alerts-last-state.json
LOG_FILE_PATH=alerts.log
LOG_RETENTION_DAYS=7

LIGHT_QUEUE=5
LIGHT_SUB_QUEUE=1
LIGHT_TG_CHAT_ID=
LIGHT_POE_URL=https://www.poe.pl.ua/customs/dynamicgpv-info.php
LIGHT_POE_POST_URL=https://www.poe.pl.ua/customs/search-disconnection.php
# Local mock values for `npm run start:light:mock`:
# LIGHT_POE_URL=http://127.0.0.1:3010/customs/dynamicgpv-info.php
# LIGHT_POE_POST_URL=http://127.0.0.1:3010/customs/search-disconnection.php
LIGHT_POST_BODY_JSON={"varn":0,"filial":"8","city_name":"с.Зайченці","street_name":"вул.Польова (Гагаріна)","building_num":"18"}
LIGHT_USE_STUB=false
LIGHT_STUB_FILE=light-example.html
GEMINI_API_KEY=
LIGHT_GEMINI_ENABLED=false
LIGHT_GEMINI_MODEL=models/gemini-flash-lite-latest
LIGHT_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LIGHT_GEMINI_TIMEOUT_MS=10000
LIGHT_GEMINI_MAX_RETRIES=1
LIGHT_GEMINI_RETRY_BASE_DELAY_MS=500
LIGHT_GEMINI_TEMPERATURE=0.2
LIGHT_GEMINI_MAX_OUTPUT_TOKENS=512
LIGHT_HTTP_TIMEOUT_MS=10000
LIGHT_HTTP_MAX_RETRIES=2
LIGHT_HTTP_RETRY_BASE_DELAY_MS=500
LIGHT_TG_HTTP_TIMEOUT_MS=10000
LIGHT_TG_HTTP_MAX_RETRIES=2
LIGHT_TG_HTTP_RETRY_BASE_DELAY_MS=500
LIGHT_LOCK_FILE_PATH=.light-job.lock
LIGHT_STATE_FILE_PATH=.light-last-state.json
LIGHT_ALWAYS_SEND_TG_MESSAGE=false
LIGHT_OUTAGE_REMINDER_BEFORE_MINUTES=0
